# Để trống khi FE và BE cùng domain; Vite dev proxy sẽ chuyển /api về localhost:3000.
VITE_API_URL=/api

# Domain chính thức, dùng cho canonical URL, OG tags tuyệt đối và sitemap.xml.
VITE_SITE_URL=https://hoalua.online

# Google Analytics 4 Measurement ID. Chỉ kích hoạt tracking khi build chạy trên domain hoalua.online.
VITE_GA_MEASUREMENT_ID=
