PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hoa_lua
DB_CONNECTION_LIMIT=10

FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Dùng chuỗi ngẫu nhiên tối thiểu 32 ký tự trên production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Chỉ dùng khi chạy `npm run admin:create --workspace=backend`, không commit giá trị thật.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Quản trị viên Họa Lụa
ADMIN_ROLE=super_admin
